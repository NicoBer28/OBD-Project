# Copy to .env.dev (development) and .env.prod (production), both git-ignored,
# and fill each with that environment's values. Never commit real values.
#
# This app does NOT auto-load .env (spring-dotenv was tried and found
# incompatible with Spring Boot 4.1.1 - it silently never fired). Load these
# into your shell before running:
#
#   set -a; source .env.dev; set +a
#   ./mvnw spring-boot:run
#
# See README.md "Running" for the production variant.
#
# or in IntelliJ: Run/Debug Configuration -> Modify options -> Environment
# variables, and paste the values there (or use an EnvFile-capable plugin).
#
# In staging/production, do NOT use .env at all - inject these via the
# platform's real secret mechanism (container env vars, Vault, cloud secret
# manager, etc.).

# Spring profile. Set to `dev` in .env.dev only (plain-HTTP cookies, small
# connection pool). Leave it unset in .env.prod and on the hosting platform so
# the production settings in application.properties apply.
SPRING_PROFILES_ACTIVE=dev

# Base64-encoded HMAC-SHA key used to sign access tokens. Generate a real one
# with: openssl rand -base64 32
JWT_SECRET=

# Postgres connection. The app will not start without a reachable database.
# DB_URL is optional and defaults to jdbc:postgresql://localhost:5432/obd.
# Flyway creates the tables on first startup; the database itself must already
# exist (createdb obd).
DB_URL=jdbc:postgresql://localhost:5432/obd
DB_USER=
DB_PASSWORD=

# Comma-separated frontend origin(s) allowed to call this API with credentials.
CORS_ORIGINS=http://localhost:5173

# Mail. Unset means `log`: messages are written to the application log and
# nothing is sent, which is what development runs on. Set MAIL_PROVIDER=resend
# (plus RESEND_API_KEY) once a sending domain exists - and never leave it as
# `log` in production, where the log would contain live tokens.
#MAIL_PROVIDER=resend
#RESEND_API_KEY=
# Seconds before a send is given up on (default 10).
#MAIL_TIMEOUT_SECONDS=10
#MAIL_FROM=no-reply@mail.yourdomain.com
#MAIL_FROM_NAME=OBD-C
# Where the links in those mails point - a universal link into the app in
# production, anything pasteable locally.
# In production these must point at the host that actually serves the two
# pages in deploy/web - the hostname in WEB_DOMAIN. Get them wrong and the
# mails arrive with links nobody can open.
#   MAIL_VERIFY_URL_BASE=https://www.obidi.com.ar/verify-email
#   MAIL_RESET_URL_BASE=https://www.obidi.com.ar/reset-password
#MAIL_VERIFY_URL_BASE=http://localhost:5173/verify-email
#MAIL_RESET_URL_BASE=http://localhost:5173/reset-password

# Where a scanned QR invite code sends the phone. The code is appended as a
# path segment, so this is the link people actually scan - in production it
# should be a universal link that opens the app (and offers the store to
# someone who does not have it). Optional; both default sensibly for local use.
# Nothing serves /join yet, so a QR scanned with the system camera (rather
# than inside the app) lands on a 404 until that page exists.
#   INVITE_JOIN_URL_BASE=https://www.obidi.com.ar/join
INVITE_JOIN_URL_BASE=http://localhost:5173/join
# How long a minted invite code stays scannable, in hours (1-168, default 24).
INVITE_CODE_TTL_HOURS=24
