# Copy to .env for local development (git-ignored). Never commit real values.
#
# This app does NOT auto-load .env (spring-dotenv was tried and found
# incompatible with Spring Boot 4.1.1 - it silently never fired). Load these
# into your shell before running:
#
#   set -a; source .env; set +a
#   ./mvnw spring-boot:run
#
# or in IntelliJ: Run/Debug Configuration -> Modify options -> Environment
# variables, and paste the values there (or use an EnvFile-capable plugin).
#
# In staging/production, do NOT use .env at all - inject these via the
# platform's real secret mechanism (container env vars, Vault, cloud secret
# manager, etc.).

# Base64-encoded HMAC-SHA key used to sign access tokens. Generate a real one
# with: openssl rand -base64 32
JWT_SECRET=

# Postgres credentials (unused for now - UserRepository is still an
# in-memory mock; see spring.autoconfigure.exclude in application.properties)
DB_USER=
DB_PASSWORD=

# Comma-separated frontend origin(s) allowed to call this API with credentials.
CORS_ORIGINS=http://localhost:5173
