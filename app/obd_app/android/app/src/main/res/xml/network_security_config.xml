<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9+ bloquea HTTP sin cifrar. Los servidores (dev y producción) usan HTTPS; esto lo
  habilita SOLO para probar con el emulador contra un backend en la PC.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- emulador de Android apuntando a la PC -->
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
