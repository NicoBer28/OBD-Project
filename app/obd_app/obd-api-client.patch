+
+    test('subir exige exactamente un destino: serial o carId', () async {
+      final api = _apiWith(MockClient((_) async => http.Response('{}', 200)));
+      final lecturas = [TelemetryReading(recordedAt: DateTime.now().toUtc())];
+
+      expect(
